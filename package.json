{
  "name": "obiweb",
  "version": "0.1.1",
  "description": "Web viewer/editor for Obsidian vaults",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run web:dev\" \"npm run server:dev\"",
    "web:dev": "cd web && vite",
    "web:build": "cd web && vite build",
    "server:dev": "node --watch server/index.js",
    "postinstall": "npm run web:build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cookie-parser": "^1.4.6",
    "scrypt-async": "^1.2.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^13.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "vite": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
