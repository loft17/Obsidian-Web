{
  "name": "obiweb",
  "version": "0.8.2",
  "description": "Web viewer/editor for Obsidian vaults",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run web:dev\" \"npm run server:dev\"",
    "web:dev": "cd web && vite",
    "web:build": "cd web && vite build",
    "server:dev": "node --watch server/index.js",
    "postinstall": "npm run web:build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.3.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
