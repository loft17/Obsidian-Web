# Puerto donde correrá la aplicación (por defecto 3000)
PORT=3000

# Secreto para firmar cookies (se genera automáticamente si no existe)
# COOKIE_SECRET=tu-secreto-aqui

# Node environment
NODE_ENV=production

# Interfaz donde escuchar. 127.0.0.1 = solo local (recomendado detrás de un proxy HTTPS).
# Sin definir escucha en todas las interfaces.
# HOST=127.0.0.1

# Pon 1 si la app está detrás de un proxy inverso (nginx, Caddy), para que el límite
# de intentos de login vea la IP real del cliente.
# TRUST_PROXY=1

# Si se define, el vault solo puede estar dentro de esta carpeta (setup y ajustes).
# VAULTS_ROOT=/srv/vaults
